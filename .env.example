# =============================================================================
# CONFIGURACIÓN DE ENTORNO — BIBLIOTECA VIRTUAL DE INGENIERÍA (FORJAS BOLÍVAR)
# =============================================================================

# --- Entorno General ---
APP_NAME="Biblioteca Virtual de Ingeniería - Forjas Bolívar"
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true

# --- Seguridad & Autenticación (ADR-002: Tabla auth.usuario + Argon2id + JWT) ---
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_WITH_64_HEX_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# --- Base de Datos (ADR-003: PostgreSQL 16 + pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fobol_engineering_kb
POSTGRES_USER=fobol_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://fobol_app:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/fobol_engineering_kb

# --- Cola Asíncrona y Caché (ADR-004: Redis + Celery/RQ) ---
REDIS_URL=redis://localhost:6379/0

# --- Almacenamiento Documental (DDD §1.1: Binarios fuera de PostgreSQL) ---
DOCUMENT_STORAGE_PATH=./storage_data/documents
REPORT_STORAGE_PATH=./storage_data/reports

# --- Servicio RAG e Inferencia Local (ADR-005: DeepSeek local + Embeddings) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=deepseek-r1:14b-q4_K_M
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024
RAG_MIN_CONFIDENCE_THRESHOLD=0.72

# --- CORS / Frontend ---
CORS_ORIGINS=["http://localhost:5173","http://bibliotecatecnica.forjasbolivar.local"]
VITE_API_BASE_URL=http://localhost:8000/api/v1

